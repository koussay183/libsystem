rules_version = '2';

// Multi-tenant rules. One shop per account; a shop's data lives under
// shops/{shopId}/… and nothing else in this file grants access to anything.
//
// READ THIS BEFORE CHANGING ANYTHING HERE:
//
// `request.auth != null` IS NOT AN AUTHORIZATION CHECK IN THIS PROJECT.
// The Firebase web API key is compiled into the app bundle that every shop
// downloads, so anybody who views source can call the sign-up endpoint and
// arrive here holding a perfectly valid, perfectly anonymous account. Being
// signed in therefore proves nothing. Owning a shop — carrying a `shopId`
// custom claim that only the admin CLI can set — is the only thing that counts,
// and every rule below is written in those terms.
//
// (Sign-up is also switched off in the console: Authentication → Settings →
// User actions → "Enable create (sign-up)" unchecked. That is a second lock on
// the same door, not a substitute for these rules.)
//
// The previous permissive file is kept as firestore.rules.rollback for the
// cutover abort path.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Who is asking
    // ---------------------------------------------------------------------

    /// A request from an account that has been provisioned as a shop.
    function isTenant() {
      return request.auth != null
        && request.auth.token.shopId is string
        && request.auth.token.shopId != '';
    }

    /// …and the shop it is provisioned for is the one it is reaching into.
    function owns(shopId) {
      return isTenant() && request.auth.token.shopId == shopId;
    }

    /**
     * Signed in AND provisioned for some shop — any shop.
     *
     * The only place this is enough is the shared catalogue, which is the one
     * collection that does not belong to a tenant. Everywhere else the question
     * is owns(shopId), and the difference is the whole security model: the web
     * API key ships in every bundle, so `request.auth != null` proves nothing
     * more than that somebody called the sign-up endpoint.
     */
    function signedShop() {
      return isTenant();
    }

    /**
     * A plan that has not run out.
     *
     * token.get('paidUntil', 0) rather than token.paidUntil: reading a claim
     * that is absent aborts the whole expression, and an aborted expression is
     * not something to leave load-bearing. `is int` is the other half — a date
     * written into the claim as an ISO string instead of a number would
     * otherwise be compared against a number, and the CLI is the only thing
     * standing between those two outcomes.
     *
     * Both mistakes now land on the same side: no write.
     */
    /**
     * 14 days, in milliseconds. KEEP IN STEP WITH RULES_GRACE_MS in cli/lib.mjs.
     *
     * Why a grace window exists at all — this is the most important comment in
     * the file. A till sells offline for a fortnight. Firestore queues every
     * ticket in IndexedDB and submits them all on reconnect, stamped with
     * request.time of the RECONNECT, not of the sale. There is no way for a rule
     * to know a write was rung days ago. So if the plan lapsed at any point
     * during the outage, a strict comparison refuses the entire queue — and
     * Firestore’s answer to a refused write is to roll it back locally. The
     * tickets were printed, the money was taken, and the sales are simply gone.
     *
     * The cost of the fix is that every plan is really worth 14 days more than it
     * says, and a shop that stops paying keeps writing for a fortnight. That is a
     * price worth paying to never destroy a queue. shops:suspend is the hard stop
     * and deliberately sets paidUntil further back than this window.
     */
    function graceMs() { return 1209600000; }

    function paid() {
      return request.auth.token.get('paidUntil', 0) is int
        && request.time.toMillis() < request.auth.token.get('paidUntil', 0) + graceMs();
    }

    // ---------------------------------------------------------------------
    // A shop's own data
    // ---------------------------------------------------------------------

    /**
     * Reads outlive the plan on purpose.
     *
     * A shop whose subscription has lapsed can still open its books, look up a
     * debt and take a full backup — it simply cannot record anything new.
     * Holding a shop's own history hostage would be the wrong way to ask for
     * money, and it would make "let me export my data first" impossible.
     */
    match /shops/{shopId}/{collection}/{document=**} {
      allow read: if owns(shopId);
      allow write: if owns(shopId) && paid();
    }

    /**
     * The shop's own record — its name, plan and dates.
     *
     * `get` only, never `list`: list would let one shop enumerate every other
     * shop on the platform. Writes are refused outright; the admin CLI uses the
     * Admin SDK, which does not pass through these rules at all.
     *
     * WHY THE BLOCK ABOVE MATCHES ON {collection}/{document=**} AND NOT ON
     * {document=**} ALONE — this is load-bearing, do not "simplify" it:
     *
     * Under rules_version '2' a recursive wildcard matches ZERO or more path
     * segments, so `/shops/{shopId}/{document=**}` also matches
     * `/shops/{shopId}` itself, with document bound to the empty path. And
     * Firestore ORs every matching rule together — one allow is enough, a
     * later `allow write: if false` refuses nothing that another match already
     * granted. Written the obvious way, therefore, this very block was dead
     * and a shop could PATCH its own record.
     *
     * That mattered more than it looks. paidUntil lives in this document, and
     * although the rules read the plan from the signed CLAIM (which no client
     * can forge), `plan:extend` reads the DOCUMENT to work out the new date.
     * A shop that rewrote its own paidUntil would be feeding a number of its
     * choosing into the next claim the back office issues — a real extension,
     * arriving one step later.
     *
     * Requiring {collection} means the shortest path that can match is
     * /shops/X/products/Y, so the shop document is left to this block alone,
     * which refuses writes. Deep subcollections are still covered, because
     * {document=**} absorbs the rest of the path.
     */
    match /shops/{shopId} {
      allow get: if owns(shopId);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Everything else, including the pre-SaaS root collections
    // ---------------------------------------------------------------------
    //
    // There is deliberately no rule for /products, /sales, /customers and the
    // rest at the root. No rule means denied, for every client, always — while
    // the Admin SDK can still read them. That is exactly what makes those
    // collections the rollback: the migration copies out of them and never
    // writes to or deletes from them, so aborting the cutover is a matter of
    // putting the old rules and the old bundle back.
    //
    // ---------------------------------------------------------------------
    // The shared barcode catalogue
    // ---------------------------------------------------------------------
    //
    // The one path in this system outside shops/{shopId}/…, and it is READ-ONLY
    // FOR EVERY CLIENT. It holds what a manufacturer's barcode is called and
    // nothing else: no price, no cost, no category, no shop id. Prices are each
    // shop's own business, and a borrowed one would be actively harmful — the
    // receiving till defaults an unknown cost to zero, so a sale price with no
    // cost behind it becomes a permanent 100 %-margin phantom in that shop's
    // profitability report.
    //
    // `get` AND NOT `read`. read includes list, and list would let any one
    // account walk the entire catalogue — every barcode every shop on the
    // platform stocks, in one query. A till only ever asks about a code it is
    // holding, so `get` is all it needs and all it gets.
    //
    // NO CLIENT WRITE, not even a create. A shop publishes by writing into its
    // own subtree at shops/{shopId}/catalog_contributions/{code}, which the
    // tenant block above already covers, and `catalog:harvest` in the CLI
    // promotes those with the Admin SDK. That is what makes this collection
    // safe: with no client-writable root path there is nothing here to flood
    // with junk, nothing to poison with a wrong name, and no per-uid bookkeeping
    // to invent. It costs immediacy, which was never the valuable part.
    //
    // Requiring a shopId claim rather than merely request.auth != null, for the
    // reason spelled out at the top of this file: the web API key ships in the
    // bundle, so anyone can sign up and arrive holding a valid anonymous
    // account. Owning a shop is the only thing that counts.
    match /catalog/{code} {
      allow get: if signedShop();

      /**
       * `list` IS ALLOWED NOW, BUT ONLY IN PAGES.
       *
       * It was refused outright, and the reason was sound: an unbounded list lets
       * one account walk the whole collection in a single query. What changed is
       * that browsing the catalogue became a feature — a shop opening for the
       * first time needs to SEE what is in there, not only get lucky with a
       * barcode it happens to be holding.
       *
       * So the risk is priced rather than avoided. Two things make it acceptable:
       *
       *  · THERE IS NO COMMERCIAL DATA HERE. Names, brands, categories, units and
       *    barcodes — what an article IS. Not one shop's cost, sale price, margin,
       *    supplier or stock. Those live under shops/{shopId}/… and no rule here
       *    exposes them. Enumerating this collection reveals roughly what walking
       *    into a bookshop reveals.
       *
       *  · THE READ BILL IS BOUNDED PER QUERY. Firestore charges the platform for
       *    every document a query returns, so an unbounded list is somebody
       *    else's money — mine. request.query.limit is the only lever the rules
       *    have over query size, and it is a real one: without a limit at or under
       *    this cap the query is refused before it reads anything.
       *
       * The one thing this deliberately does not do is stop a determined account
       * from paging through the whole catalogue a hundred documents at a time. No
       * rule can. That is what App Check is for, and it is still on the list.
       *
       * The official school books carry a regulated price, and that is not an
       * exception to "no prices here" — a manuel scolaire costs the same in every
       * librairie in Tunisia by law. It is a fact about the book, like its title.
       */
      allow list: if signedShop() && request.query.limit <= 120;

      allow write: if false;
    }
  }
}
