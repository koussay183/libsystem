# ---------------------------------------------------------------------------
# Firebase configuration
# ---------------------------------------------------------------------------
# 1. Copy this file to ".env.local"  ->  cp .env.example .env.local
# 2. In the Firebase console open:  Project settings > General > Your apps
#    (web app). Copy the values from the "firebaseConfig" object here.
# 3. These values are PUBLIC by design (they ship in the browser). The app is
#    secured by Firebase Authentication + Firestore rules, not by hiding them.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# There is no app password any more. Accounts are real Firebase Auth users,
# created from the admin CLI — see SAAS.md.
