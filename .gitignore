# dependencies
node_modules
.pnp
.pnp.js

# build
dist
dist-ssr
*.local

# env (contains your Firebase config — keep private)
.env
.env.local
.env.*.local

# firebase
.firebase
.firebaserc
firebase-debug.log
firestore-debug.log
# emulator logs, if the emulators are ever started from the repo instead of
# through scripts/qa/up.sh (which keeps them in /tmp/qa)
*-debug.log
firebase-export-*/

# local QA harness (scripts/qa): its own deps; run state lives in /tmp/qa
temp_auto_push.bat
scripts/qa/node_modules/

# editor / OS
.idea
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Netlify folder
.netlify

# live client data pulled for safekeeping — never commit
backups/
cli/service-account*.json

# frozen config of the pre-SaaS project, for the one-time pull
.env.legacy
.claude/worktrees/

# admin CLI credentials — never commit, wherever they are saved
service-account.json
**/service-account*.json
*-firebase-adminsdk-*.json
.gitignore
branch_structure.json
